<%- include('../admin/navbar') %>

<div class="container mt-4">

  <!-- Heading + Add About Button -->
  <div class="d-flex align-items-center mb-3 gap-2">
    <h3 class="mb-0">About Us List</h3>
    <a href="/admin/aboutus" class="btn btn-primary">Add About</a>
  </div>

  <% if (aboutData.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-bordered table-hover text-center align-middle">
        <thead class="table-primary">
          <tr>
            <th>#</th>
            <th>Title</th>
            <th>Icon</th>
            <th>Description</th>
            <th>Image</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% aboutData.forEach((item, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= item.title %></td>
              <td>
                <% if(item.icon) { %>
                  <i class="<%= item.icon %>"></i>
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td class="text-start"><%= item.description %></td>
              <td>
                <% if (item.image) { %>
                  <img src="/uploads/<%= item.image %>" alt="About Image" style="height:80px; width:auto; border-radius:5px;">
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td>
                <a href="/admin/edit_aboutus/<%= item.about_id %>" class="btn btn-sm btn-warning">Edit</a>
                <a href="/admin/delete_aboutus/<%= item.about_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this entry?')">Delete</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-center text-muted fs-5 mt-4">No About Us content found.</p>
  <% } %>

</div>

<style>
  /* Optional: make table rows more readable */
  table tbody tr:hover {
    background-color: #f2f2f2;
  }

  td img {
    object-fit: cover;
  }

  td i {
    font-size: 1.2rem;
    color: #555;
  }
</style>
