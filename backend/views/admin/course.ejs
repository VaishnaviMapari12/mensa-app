<%- include('navbar') %>

<div class="container-fluid mt-4">
  <div class="row">
    <!-- Sidebar (optional) -->
    <div class="col-md-2">
      <!-- Sidebar goes here if needed -->
    </div>

    <!-- Main Content -->
    <div class="col-md-10">
      <div class="card shadow p-4 mb-4">
        <h2 class="text-center mb-4">Add New Course</h2>

        <form action="/admin/save_course" method="post" enctype="multipart/form-data">
          <div class="mb-3">
            <label>Course Name</label>
            <input type="text" name="course_name" class="form-control" required />
          </div>

          <div class="mb-3">
            <label>Course Image</label>
            <input type="file" name="course_image" class="form-control" />
          </div>

          <div class="mb-3">
            <label>Course Duration</label>
            <input type="text" name="course_duration" class="form-control" />
          </div>

          <div class="mb-3">
            <label>Course Banner</label>
            <input type="text" name="course_banner" class="form-control" />
          </div>

          <div class="mb-3">
            <label>Course Language</label>
            <input type="text" name="course_language" class="form-control" />
          </div>

          <div class="mb-3">
            <label>Course Price</label>
            <input type="number" name="course_price" class="form-control" />
          </div>

          <button type="submit" class="btn btn-success w-100">Save Course</button>
        </form>

        <div class="mt-3 text-center">
          <a href="/admin/course_list" class="btn btn-primary">View All Courses</a>
        </div>
      </div>
    </div>
  </div>
</div>
