<%- include('navbar') %>

<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-md-2">
      <!-- Sidebar if needed -->
    </div>

    <div class="col-md-10">
      <h2 class="text-center mb-4">Existing Courses</h2>

      <table class="table table-bordered table-striped">
        <thead class="table-primary">
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Image</th>
            <th>Duration</th>
            <th>Banner</th>
            <th>Language</th>
            <th>Price</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(courses.length > 0) { %>
            <% courses.forEach(course => { %>
              <tr>
                <td><%= course.course_id %></td>
                <td><%= course.course_name %></td>
                <td>
                  <% if(course.course_image) { %>
                    <img src="/uploads/<%= course.course_image %>" width="50" class="img-thumbnail" />
                  <% } %>
                </td>
                <td><%= course.course_duration %></td>
                <td><%= course.course_banner %></td>
                <td><%= course.course_language %></td>
                <td><%= course.course_price %></td>
                <td>
                  <a href="/admin/edit_course/<%= course.course_id %>" class="btn btn-warning btn-sm mb-1">Edit</a>
                  <a href="/admin/delete_course/<%= course.course_id %>" class="btn btn-danger btn-sm mb-1" onclick="return confirm('Are you sure?')">Delete</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center">No courses added yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <div class="mt-3 text-center">
        <a href="/admin/courses" class="btn btn-success">Add New Course</a>
      </div>
    </div>
  </div>
</div>
