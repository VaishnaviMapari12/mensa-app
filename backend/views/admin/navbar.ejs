<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>



<style>
  :root {
    --main-color: white;
    --hover-color: white;
    --sidebar-bg: #212427;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
  }

  /* Sidebar */
  #adminSidebar {
    width: 220px;
    min-height: 100vh;
    background: var(--sidebar-bg);
    color: #fff;
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem 0;
  }

  #adminSidebar h3 {
    color: var(--main-color);
    padding: 0 1rem;
    font-size: 18px;
    margin-bottom: 1rem;
  }

  #adminSidebar ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  #adminSidebar .nav-item {
    width: 100%;
  }

  #adminSidebar .nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 1rem;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    transition: 0.3s;
    cursor: pointer;
  }

  #adminSidebar .nav-link i {
    min-width: 20px;
    color: var(--main-color);
    transition: 0.3s;
  }

  #adminSidebar .nav-link:hover,
  #adminSidebar .nav-link.active {
    background: #3c3c50;
    color: var(--hover-color);
  }

  /* Submenu */
  .submenu {
    list-style: none;
    padding-left: 20px;
    display: none;
  }

  .submenu .nav-link {
    font-size: 14px;
    padding: 6px 1rem;
  }

  .nav-item.show > .submenu {
    display: block;
  }

  /* Sidebar toggle */
  .sidebar-toggle {
    display: none;
    position: fixed;
    top: 1rem;
    left: 1rem;
    font-size: 1.5rem;
    color: var(--main-color);
    z-index: 200;
  }

  @media (max-width: 768px) {
    #adminSidebar {
      left: -220px;
      transition: left 0.3s;
    }
    #adminSidebar.active {
      left: 0;
    }
    .sidebar-toggle {
      display: block;
    }
  }
</style>

<!-- Mobile Toggle Button -->
<button class="sidebar-toggle d-md-none">
  <i class="fas fa-bars"></i>
</button>

<!-- Sidebar -->
<nav id="adminSidebar">

  <!-- Logo Section -->
  <div class="text-center p-3">
      <img src="https://mensaclasses.com/images/logo-mensa.png" width="200" class="img-fluid rounded-circle mb-2">
      <h5 class="my-2">Mensa Class</h5>
  </div>

  <!-- MENU -->
  <div>
    <h3><i class="fas fa-tools"></i> Admin Panel</h3>

    <ul>

      <!-- HOME (NO DROPDOWN) -->
      <li class="nav-item">
        <a href="/admin/home" class="nav-link">
          <i class="fas fa-house-user"></i> Home
          <li><a href="/admin/slider" class="nav-link"><i class="fas fa-plus-circle"></i> slider</a></li>
          <li><a href="/admin/aboutus" class="nav-link"><i class="fas fa-list-ol"></i> aboutus</a></li>
        </a>
      </li>

      <!-- About Dropdown -->
      <li class="nav-item">
        <a class="nav-link">
          <i class="fas fa-info-circle"></i> About Us
          <i class="fas fa-angle-down ms-auto"></i>
        </a>
        <ul class="submenu">
          <li><a href="/admin/about" class="nav-link"><i class="fas fa-plus-circle"></i> Add About</a></li>
          <li><a href="/admin/about_list" class="nav-link"><i class="fas fa-list-ol"></i> List About</a></li>
        </ul>
      </li>

      <!-- Contact Dropdown -->
      <li class="nav-item">
        <a class="nav-link">
          <i class="fas fa-envelope-open-text"></i> Contact
          <i class="fas fa-angle-down ms-auto"></i>
        </a>
        <ul class="submenu">
          <li><a href="/admin/contact" class="nav-link"><i class="fas fa-plus-circle"></i> Add Contact</a></li>
          <li><a href="/admin/contact_list" class="nav-link"><i class="fas fa-list-ol"></i> List Contacts</a></li>
        </ul>
      </li>

      <!-- Testimonials Dropdown -->
      <li class="nav-item">
        <a class="nav-link">
          <i class="fas fa-comments"></i> Testimonials
          <i class="fas fa-angle-down ms-auto"></i>
        </a>
        <ul class="submenu">
          <li><a href="/admin/testimonials" class="nav-link"><i class="fas fa-plus-circle"></i> Add Testimonial</a></li>
          <li><a href="/admin/testimonials_list" class="nav-link"><i class="fas fa-list-ol"></i> List Testimonials</a></li>
        </ul>
      </li>

      <!-- Student Corner -->
      <li class="nav-item">
        <a class="nav-link">
          <i class="fas fa-user-graduate"></i> Student Corner
          <i class="fas fa-angle-down ms-auto"></i>
        </a>
        <ul class="submenu">
          <li><a href="/admin/studentcorner" class="nav-link"><i class="fas fa-plus-circle"></i> Add Student</a></li>
          <li><a href="/admin/studentcorner_list" class="nav-link"><i class="fas fa-list-ol"></i> List Students</a></li>
        </ul>
      </li>

      <!-- Courses -->
      <li class="nav-item">
        <a class="nav-link">
          <i class="fas fa-book"></i> Courses
          <i class="fas fa-angle-down ms-auto"></i>
        </a>
        <ul class="submenu">
          <li><a href="/admin/courses" class="nav-link"><i class="fas fa-plus-circle"></i> Add Course</a></li>
          <li><a href="/admin/courses_list" class="nav-link"><i class="fas fa-list-ol"></i> List Courses</a></li>
        </ul>
      </li>

      <!-- Results -->
      <li class="nav-item">
        <a class="nav-link">
          <i class="fas fa-chart-bar"></i> Results
          <i class="fas fa-angle-down ms-auto"></i>
        </a>
        <ul class="submenu">
          <li><a href="/admin/results" class="nav-link"><i class="fas fa-plus-circle"></i> Add Result</a></li>
          <li><a href="/admin/result_list" class="nav-link"><i class="fas fa-list-ol"></i> List Results</a></li>
        </ul>
      </li>

      <!-- Timetable -->
      <li class="nav-item">
        <a class="nav-link">
          <i class="fas fa-calendar-alt"></i> Timetable
          <i class="fas fa-angle-down ms-auto"></i>
        </a>
        <ul class="submenu">
          <li><a href="/admin/timetable" class="nav-link"><i class="fas fa-plus-circle"></i> Add Timetable</a></li>
          <li><a href="/admin/timetable_list" class="nav-link"><i class="fas fa-list-ol"></i> List Timetable</a></li>
        </ul>
      </li>

    </ul>
  </div>

  <!-- BOTTOM -->
  <div class="mb-4">
    <ul>
      <li class="nav-item"><a href="/admin/logout" class="nav-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
      <li class="nav-item"><a href="/admin/settings" class="nav-link"><i class="fas fa-sliders-h"></i> Settings</a></li>
      <li class="nav-item"><a href="/admin/login" class="nav-link"><i class="fas fa-user-circle"></i> Login</a></li>
    </ul>
  </div>

</nav>

<script>
  // Mobile Sidebar Toggle
  document.querySelector('.sidebar-toggle').addEventListener('click', () => {
    document.querySelector('#adminSidebar').classList.toggle('active');
  });

  // Dropdown Toggle
  document.querySelectorAll('#adminSidebar .nav-item > .nav-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const submenu = link.nextElementSibling;
      if(submenu && submenu.classList.contains('submenu')) {
        e.preventDefault();
        link.parentElement.classList.toggle('show');
      }
    });
  });
</script>
