<%- include('../admin/navbar') %>

<div class="container mt-4">
  <div class="d-flex align-items-center mb-3 gap-2">
    <h3 class="mb-0">Results List</h3>
    <a href="/admin/results" class="btn btn-success">Add Result</a>
  </div>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Name</th>
        <th>Image</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% results.forEach(result => { %>
        <tr>
          <td><%= result.result_id %></td>
          <td><%= result.title %></td>
          <td><%= result.name %></td>
          <td>
            <% if(result.image){ %>
              <img src="/uploads/<%= result.image %>" height="70">
            <% } else { %>
              No Image
            <% } %>
          </td>
          <td>
            <a href="/admin/result/edit/<%= result.result_id %>" class="btn btn-warning btn-sm">Edit</a>
            <a href="/admin/result_delete/<%= result.result_id %>" class="btn btn-danger btn-sm">Delete</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
