<%- include('../admin/navbar') %>

<div class="container mt-4" style="margin-left: 220px;"> <!-- Left sidebar space -->
  <h3 class="mb-3">Edit Slider</h3>
  <a href="/admin/slider_list" class="btn btn-secondary mb-3">Back to Slider List</a>

  <div class="card shadow p-4 mb-4">
    <form action="/admin/update_slider/<%= slider.slider_id %>" method="post" enctype="multipart/form-data">

      <div class="mb-3">
        <label><b>Slider Name</b></label>
        <input type="text" name="slider_name" class="form-control" value="<%= slider.slider_name %>" required>
      </div>

      <div class="row">
        <!-- LEFT IMAGE -->
        <div class="col-md-6 mb-3">
          <label><b>Logo Image</b></label>
          <% if (slider.left_image) { %>
            <div class="mb-2">
              <img src="/uploads/<%= slider.left_image %>" width="120" height="120" style="object-fit:cover">
            </div>
          <% } %>
          <input type="file" name="left_image" class="form-control">
        </div>

        <!-- RIGHT IMAGES -->
        <div class="col-md-6">
          <div class="row">
            <% for (let i = 1; i <= 4; i++) { %>
              <div class="col-6 mb-3">
                <label>Image <%= i %></label>
                <% if (slider['right_image' + i]) { %>
                  <div class="mb-2">
                    <img src="/uploads/<%= slider['right_image' + i] %>" width="100" height="100" style="object-fit:cover">
                  </div>
                <% } %>
                <input type="file" name="right_image<%= i %>" class="form-control">
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="text-center mt-3">
        <button type="submit" class="btn btn-primary">Update Slider</button>
      </div>
    </form>
  </div>
</div>
