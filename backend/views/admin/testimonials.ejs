<!-- Container -->
<div class="testimonials-page">

  <!-- ADD TESTIMONIAL FORM -->
  <div class="form-container">
    <div class="form-card">
      <h1 class="form-title">Add New Testimonial</h1>
      <form action="/admin/testimonials" method="POST">
        <div class="form-group">
          <label>Student Name</label>
          <input type="text" name="name" placeholder="Enter Student Name" required>
        </div>
        <div class="form-group">
          <label>Course Name</label>
          <input type="text" name="course" placeholder="Enter Course Name" required>
        </div>
        <div class="form-group">
          <label>Testimonial Message</label>
          <textarea name="message" rows="6" placeholder="Write your testimonial here..." required></textarea>
        </div>
        <button type="submit" class="btn-submit">Add Testimonial</button>
      </form>
    </div>
  </div>

  <!-- EXISTING TESTIMONIALS -->
  <% if(testimonials && testimonials.length > 0) { %>
  <div class="testimonials-container">
    <h2>Existing Testimonials</h2>
    <div class="testimonials-grid">
      <% testimonials.forEach(t => { %>
        <div class="testimonial-card">
          <h3 class="testimonial-name"><%= t.name %></h3>
          <h4 class="testimonial-course"><%= t.course %></h4>
          <p class="testimonial-message"><%= t.message %></p>
        </div>
      <% }) %>
    </div>
  </div>
  <% } else { %>
    <p class="no-testimonials">No testimonials yet.</p>
  <% } %>
</div>

<style>
/* =================== GENERAL =================== */
body, html {
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #f0f2f5;
}

/* =================== FORM SECTION =================== */
.form-container {
  display: flex;
  justify-content: center;
  padding: 60px 20px;
}

.form-card {
  background-color: #ffffff;
  padding: 50px 40px;
  border-radius: 20px;
  box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  width: 100%;
  max-width: 700px;
}

.form-title {
  text-align: center;
  color: #0d6efd;
  font-size: 3rem;
  margin-bottom: 40px;
  font-weight: bold;
}

.form-group {
  margin-bottom: 25px;
}

.form-group label {
  display: block;
  font-size: 1.3rem;
  font-weight: 600;
  margin-bottom: 10px;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 18px 20px;
  border-radius: 12px;
  border: 1px solid #ccc;
  font-size: 1.1rem;
  outline: none;
  transition: 0.3s;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #0d6efd;
  box-shadow: 0 0 8px rgba(13, 110, 253, 0.2);
}

textarea {
  resize: none;
}

.btn-submit {
  width: 100%;
  padding: 20px;
  background-color: #0d6efd;
  color: white;
  font-size: 1.5rem;
  font-weight: 600;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: 0.3s;
}

.btn-submit:hover {
  background-color: #0b5ed7;
  transform: translateY(-2px);
}

/* =================== TESTIMONIALS =================== */
.testimonials-container {
  max-width: 1200px;
  margin: 0 auto 60px auto;
  padding: 0 20px;
}

.testimonials-container h2 {
  text-align: center;
  color: #333;
  font-size: 2.5rem;
  font-weight: bold;
  margin-bottom: 50px;
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 30px;
}

.testimonial-card {
  background-color: #ffffff;
  padding: 30px 25px;
  border-radius: 18px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  transition: 0.3s;
}

.testimonial-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 30px rgba(0,0,0,0.15);
}

.testimonial-name {
  color: #0d6efd;
  font-size: 1.6rem;
  font-weight: bold;
  margin-bottom: 5px;
}

.testimonial-course {
  color: #6c757d;
  font-size: 1.2rem;
  margin-bottom: 15px;
}

.testimonial-message {
  font-size: 1.1rem;
  color: #333;
  line-height: 1.6;
}

.no-testimonials {
  text-align: center;
  font-size: 1.5rem;
  color: #6c757d;
  margin-top: 40px;
}
</style>